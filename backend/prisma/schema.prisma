// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sex {
  MALE
  FEMALE
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

model Users {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  phone        String?    @unique
  sex          Sex?
  picture_url  String?   // optional
  is_deleted   Boolean   @default(false)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  password     String
  verifyToken  String?
  isVerified   Boolean   @default(false)

  // created_by → user yang membuat user ini (misal admin membuat customer)
  created_by   String?  
  createdBy    Users?    @relation("UserCreatedUsers", fields: [created_by], references: [id])
  createdUsers Users[]   @relation("UserCreatedUsers")

  // relation dengan Orders
  orders       Orders[]       @relation("UserOrders") // sebagai pembeli
  courierOrders Orders[]      @relation("CourierOrders") // sebagai kurir

  // relation dengan Address
  addresses    Address[]

  // relation dengan Roles
  roleId       String?
  role         Roles?         @relation(fields: [roleId], references: [id])

  //relation dengan cart
  cart Cart? @relation("UserCart")
}

model Cart {
  id  String @id @default(uuid())
  userId String @unique
  user Users @relation("UserCart", fields: [userId], references: [id])

  items CartItem[]
}

model CartItem {
  cartId String
  productId String
  quantity Int

  cart Cart @relation(fields: [cartId], references:[id])
  product Products @relation(fields: [productId], references:[id])

  @@id([cartId, productId])
}

model Address {
  id           String   @id @default(uuid())
  label        String
  fullAddress       String
  sub_district String?
  district     String?
  city         String?
  province     String
  country      String
  postal_code  String

  //menambahkan fields lat dan lng untuk tracking lokasi user secara realtime untuk kemudahan kurir dengan mapbox api
  latitude     Float
  longitude    Float

  // relation dengan Users
  userId String
  user   Users   @relation(fields: [userId], references: [id])
}

model Roles {
  id         String    @id @default(uuid())
  name       String
  created_at DateTime  @default(now())

  // relation dengan Users
  users      Users[]
  
  // relation dengan AccessPermissions
  permissions AccessPermissions[]
}

model AccessPermissions {
  id          String   @id @default(cuid())
  acccess_key String
  is_deleted  Boolean  @default(false)

  // relation dengan Roles
  roleId String
  role   Roles @relation(fields: [roleId], references: [id])
}

model Orders {
  id           String       @id @default(uuid())
  order_status OrderStatus
  is_deleted   Boolean      @default(false)
  created_at   DateTime     @default(now())

  // user yang buat order
  userId String
  user   Users   @relation("UserOrders", fields: [userId], references: [id])

  // courier yang terima order
  courierId String?
  courier   Users?  @relation("CourierOrders", fields: [courierId], references: [id])

  //detail item yang di order
  items OrderItem[]
}

model OrderItem {
  orderId String 
  productId String
  quantity Int
  price Float 
  
  order Orders @relation(fields:[orderId], references:[id])
  product Products @relation(fields:[productId], references:[id])

  @@id([orderId, productId])
}

model Products {
  id          String   @id @default(uuid())
  name        String
  sku         String   @unique
  description String?
  stock       Int
  unit        String?
  price       Float
  cost        Float
  picture_url String
  is_active   Boolean  @default(true)
  is_deleted  Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // relation dengan Category
  categoryId String?
  category   Categories? @relation(fields: [categoryId], references: [id])

  //relation dengan cartItem
  cartItems CartItem[]

  //relation dengan OrderItem
  orderItems OrderItem[]
}

model Categories {
  id          String     @id @default(uuid())
  name        String
  description String?
  picture_url String?
  is_deleted  Boolean    @default(false)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  // relation dengan Products
  products    Products[]
}

